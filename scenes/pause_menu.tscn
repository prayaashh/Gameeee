[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/autoload/pause_menu.gd" id="1_pause"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_pn"]
content_margin_left = 20.0
content_margin_top = 16.0
content_margin_right = 20.0
content_margin_bottom = 16.0
bg_color = Color(0.06, 0.07, 0.1, 0.94)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 100
script = ExtResource("1_pause")

[node name="Dim" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.5)

[node name="Center" type="CenterContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
layout_mode = 2
custom_minimum_size = Vector2(260, 0)
theme_override_styles/panel = SubResource("StyleBoxFlat_pn")

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Paused"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Resume"

[node name="RestartButton" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Restart"

[node name="QuitButton" type="Button" parent="Center/Panel/VBox"]
layout_mode = 2
text = "Quit"

[connection signal="pressed" from="Center/Panel/VBox/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Center/Panel/VBox/RestartButton" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="Center/Panel/VBox/QuitButton" to="." method="_on_quit_pressed"]
